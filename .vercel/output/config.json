{
	"version": 3,
	"routes": [
		{
			"src": "/\\/privacy/",
			"headers": {
				"Location": "/privacy"
			},
			"status": 308
		},
		{
			"src": "/\\/support/",
			"headers": {
				"Location": "/support"
			},
			"status": 308
		},
		{
			"src": "/\\/404/",
			"headers": {
				"Location": "/404"
			},
			"status": 308
		},
		{
			"src": "/(?:\\/(.*?))?\\/([^/]+?)(?:\\/(.*?))?/",
			"headers": {
				"Location": "/$1/$2/$3"
			},
			"status": 308
		},
		{
			"src": "/(?:\\/(.*?))?\\/([^/]+?)(?:\\/(.*?))?/",
			"headers": {
				"Location": "/$1/$2/$3"
			},
			"status": 308
		},
		{
			"src": "/(?:\\/(.*?))?(?:\\/(.*?))?/",
			"headers": {
				"Location": "/$1/$2"
			},
			"status": 308
		},
		{
			"src": "/(?:\\/(.*?))?/",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		}
	],
	"images": {
		"sizes": [
			640,
			750,
			828,
			1080,
			1200,
			1920,
			2048,
			3840
		],
		"domains": [],
		"remotePatterns": []
	}
}