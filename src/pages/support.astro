---
import Layout from '~/layouts/PageLayout.astro';
import { getCanonical } from '~/utils/permalinks';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Support',
  description: 'Get help with the Workout Quest app and other apps from DJ Applications',
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Workout Quest Support',
  url: String(getCanonical('/support')),
  description: metadata.description,
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  <Content tagline="Support" title="Contact Our Support Team">
    <Fragment slot="content">
      <h1 class="text-4xl text-center font-bold mb-8">Contact Our Support Team</h1>
      <p class="text-lg text-center">
        Have questions or experiencing issues? Our dedicated support team is
        ready to assist you with any problems related to Workout Quest and
        our other apps from DJ Applications <br></br>
        <a href="mailto:support@workoutquestapp.com" class="mx-auto btn btn-primary mt-4 mb-8 md:mb-0 text-center w-full md:w-auto">Email Support Here</a>
      </p>
      <div class="max-w-2xl mx-auto mt-10 text-left">
        <h2 class="text-2xl font-bold mt-8 mb-3">What we can help with</h2>
        <ul class="list-disc pl-6 space-y-1">
          <li>Account and sync issues across devices</li>
          <li>Workout logging, quests, streaks, and achievements</li>
          <li>Exercise library and AI coach questions</li>
          <li>Feature requests and feedback</li>
        </ul>
        <h2 class="text-2xl font-bold mt-8 mb-3">Before you reach out</h2>
        <p>
          Include your device model (iPhone or Android), the app version shown in the app settings, and a short
          description of what happened. Screenshots or a screen recording help us resolve issues faster.
        </p>
        <h2 class="text-2xl font-bold mt-8 mb-3">Getting started</h2>
        <p>
          Workout Quest is free to download on iOS and Android. The app works offline, so you can log workouts without
          a connection and sync later. If you are new to the app, start with the onboarding quests, which walk you
          through logging your first workout and setting up your first streak.
        </p>
      </div>
    </Fragment>
  </Content>
</Layout>
