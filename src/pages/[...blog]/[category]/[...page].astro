---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getCanonical, getHomePermalink, getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { buildBreadcrumbSchema } from '~/utils/seo';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: string };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;
const categoryName = category.replaceAll('-', ' ');

const categoryContent = {
  fitness: {
    title: 'Workout Quest Fitness Guides',
    description:
      'Explore Workout Quest articles on gamified fitness, recovery, wearables, motivation, and training systems that make consistency easier to sustain.',
    subtitle:
      'A curated archive of Workout Quest stories on recovery, motivation, wearables, and long-term fitness consistency.',
  },
  training: {
    title: 'Workout Quest Training Guides',
    description:
      'Browse Workout Quest training articles covering workout structure, progressive overload, training frequency, and practical routines for different schedules.',
    subtitle:
      'A focused archive of Workout Quest training articles on programming, exercise structure, and workout design.',
  },
}[category] || {
  title: `Workout Quest ${categoryName} Articles`,
  description: `Browse Workout Quest articles in ${categoryName} with practical insights, examples, and guides for staying consistent.`,
  subtitle: `Browse Workout Quest articles related to ${categoryName}.`,
};

const metadata = {
  title: `${categoryContent.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: currentPage > 1 ? `${categoryContent.description} Page ${currentPage}.` : categoryContent.description,
  robots: {
    index: blogCategoryRobots?.index && currentPage === 1,
    follow: blogCategoryRobots?.follow,
  },
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', item: String(getCanonical(getHomePermalink())) },
  { name: 'Blog', item: String(getCanonical(getBlogPermalink())) },
  { name: categoryName, item: String(getCanonical(getPermalink(category, 'category'))) },
]);

const breadcrumbItems = [
  { name: 'Home', href: getHomePermalink() },
  { name: 'Blog', href: getBlogPermalink() },
  { name: categoryName },
];
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <Breadcrumbs items={breadcrumbItems} />
    <Headline subtitle={categoryContent.subtitle}>
      <span class="capitalize">{categoryName}</span>
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
