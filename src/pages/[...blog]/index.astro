---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';

import { getCanonical, getPermalink, getHomePermalink, getBlogPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { buildBreadcrumbSchema } from '~/utils/seo';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

const breadcrumbItems = [
  { name: 'Home', item: String(getCanonical('/')) },
  { name: 'Blog', item: String(getCanonical('/blog')) },
  ...(post.category ? [{ name: post.category.replaceAll('-', ' '), item: String(getCanonical(getPermalink(post.category, 'category'))) }] : []),
  { name: post.title, item: String(url) },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const breadcrumbLinks = [
  { name: 'Home', href: getHomePermalink() },
  { name: 'Blog', href: getBlogPermalink() },
  ...(post.category ? [{ name: post.category.replaceAll('-', ' '), href: getPermalink(post.category, 'category') }] : []),
  { name: post.title },
];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-8 md:pt-12">
    <Breadcrumbs items={breadcrumbLinks} class="mb-4" />
  </div>
  <SinglePost post={{ ...post, image: image }} url={url} />
  <ToBlogLink />
</Layout>
