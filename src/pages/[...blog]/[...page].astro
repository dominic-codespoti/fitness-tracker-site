---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { buildBreadcrumbSchema } from '~/utils/seo';
import { getCanonical, getHomePermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// Example: Fetch categories and tags related to workouts and fitness
// const allCategories = await findCategories(['Workouts', 'Nutrition', 'Success Stories']);
// const allTags = await findTags(['HIIT', 'Yoga', 'Weightlifting']);

const metadata = {
  ignoreTitleTemplate: true,
  title:
    currentPage > 1
      ? `Workout Quest Blog Archive — Page ${currentPage}`
      : 'Workout Quest Blog: Fitness, Recovery, and Training Guides',
  description:
    currentPage > 1
      ? `Browse page ${currentPage} of the Workout Quest blog archive for fitness, recovery, wearable, and training articles.`
      : 'Explore Workout Quest articles on gamified fitness, recovery, wearables, motivation, and practical training systems.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', item: String(getCanonical(getHomePermalink())) },
  { name: 'Blog', item: String(getCanonical(getBlogPermalink())) },
]);

const breadcrumbItems = [
  { name: 'Home', href: getHomePermalink() },
  { name: 'Blog' },
];
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <Breadcrumbs items={breadcrumbItems} />
    <Headline
      subtitle="Deep dives into fitness systems, gamification, recovery, wearables, and practical training ideas from the Workout Quest team."
    >
      Workout Quest Blog
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />

    <!-- Optional: Enable if you have categories and tags implemented -->
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Explore Categories:" isCategory />
      <PostTags tags={allTags} title="Discover Topics:" />
    -->
  </section>
</Layout>
