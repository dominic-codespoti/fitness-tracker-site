            href="https://play.google.com/store/apps/details?id=fitness.tracker&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1"
            target="_blank"
            class="px-6 py-3 bg-primary rounded-lg text-white flex items-center space-x-2">
            <span>Android Play Store</span>
            <icon name="tabler:download"></icon>
