---

<Layout metadata={metadata}>
  <section class="relative bg-black h-screen">
    <!-- Background Video with fast first paint (LQIP poster + swap to video when ready) -->
    <!-- Inline SVG LQIP used as immediate poster (data URI) -->
    <div id="hero-media" class="absolute inset-0 w-full h-full">
      <!-- instant paint placeholder (SVG gradient) -->
      <img id="hero-poster" class="absolute inset-0 w-full h-full object-cover" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='900'><defs><linearGradient id='g' x1='0' x2='1' y1='0' y2='1'><stop offset='0' stop-color='%230f172a'/><stop offset='1' stop-color='%23000'/></linearGradient></defs><rect width='100%' height='100%' fill='url(%23g)' /></svg>" alt="Hero background" aria-hidden="true" />

      <!-- actual video (kept muted + autoplay). Initially hidden until it can play to avoid late paint jank -->
      <video id="hero-video" muted playsinline loop preload="metadata" class="absolute inset-0 object-cover w-full h-full opacity-0 transition-opacity duration-300 pointer-events-none" poster="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1600' height='900'><rect width='100%' height='100%' fill='%23000000'/></svg>'" aria-hidden="true">
        <source src="/landing.mp4" type="video/mp4" />
        <!-- optional webm fallback could be added here -->
      </video>
    </div>
  
    <!-- Overlay Content -->
