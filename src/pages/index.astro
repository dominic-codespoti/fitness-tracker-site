---
import profileScreenshot from '~/assets/images/ss-profile.png';
import heroPosterImage from '~/assets/images/ss-building.png';

import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Workout Quest: Gamified Workout Tracker App',
  ignoreTitleTemplate: true,
  description:
    'Track your exercises, earn achievements and level up as you train, at home or at the gym, with Workout Quest. Download the app for free on iOS and Android!',
  robots: {
    index: true,
    follow: true,
  },
  canonical: 'https://www.workoutquestapp.com/',
};

const faqItems = [
  {
    title: 'How does Workout Quest work?',
    description:
      'Workout Quest gamifies your fitness and exercise experience by letting you track workouts through a massive exercise database, logging reps, sets, and weights, and rewarding XP, achievements, and insights as you train.',
    icon: 'tabler:info-circle',
  },
  {
    title: 'What makes Workout Quest unique in tracking workouts?',
    description:
      'Workout Quest mixes AI-driven personalization, an extensive workout library, and a community layer that turns routine exercise into an engaging, motivational adventure with detailed analytics.',
    icon: 'tabler:star',
  },
  {
    title: 'Can Workout Quest help me create a personalized fitness plan?',
    description:
      'The premium tier uses AI to craft workout plans tailored to your fitness level, goals, and available equipment, so every session feels purposeful and on-track.',
    icon: 'tabler:adjustments',
  },
  {
    title: 'How does the achievement system motivate Workout Quest users?',
    description:
      'Achievements, badges, and streaks celebrate every milestone, combining recognition with healthy competition inside the community so you keep showing up.',
    icon: 'tabler:trophy',
  },
  {
    title: 'Is Workout Quest suitable for beginners?',
    description:
      'With detailed GIF demonstrations, muscle-group filters, equipment tags, and helpful “hot” actions, beginners can explore workouts confidently before branching into more advanced routines.',
    icon: 'tabler:user-plus',
  },
  {
    title: 'How does Workout Quest support community and social features?',
    description:
      'Connect with friends, share achievements, and challenge each other in quests to build accountability through shared wins inside a welcoming fitness community.',
    icon: 'tabler:users',
  },
];

const blogHighlights = [
  {
    title: 'Gamification moves bodies faster',
    description:
      'Why leveling systems, quests, and rewards keep motivation high—plus how Workout Quest mirrors your real-world progress with XP, quests, and leaderboards.',
    icon: 'tabler:help-hexagon',
      callToAction: {
      text: 'Read Gamification Guide',
      href: getPermalink('the-ultimate-guide-to-gamifying-your-home-workouts', 'post'),
      icon: 'tabler:arrow-right',
      variant: 'link',
    },
  },
  {
    title: 'Where fitness tech is going next',
    description:
      'A theorycrafting dive into the trends shaping fit-tech, AI coaches, and gamified experiences for 2025.',
    icon: 'tabler:radar',
    callToAction: {
      text: 'Read Trends for 2025',
      href: getPermalink('future-of-fitness-gamification-trends-2025', 'post'),
      icon: 'tabler:arrow-right',
      variant: 'link',
    },
  },
];

const quickReads = [
  {
    title: 'Turn recovery into a quest',
    description:
      'Wearable readiness scores, sleep, and HRV turn rest days into data-driven quests that reward smart recovery alongside hard training.',
    href: getPermalink('smart-recovery-quests-wearables', 'post'),
  },
  {
    title: 'Theorycrafting the future',
    description:
      'Future of Fitness Gamification Trends 2025 maps how AI, community quests, and exploratory features will keep the app one step ahead of the crowded tracker category.',
    href: getPermalink('future-of-fitness-gamification-trends-2025', 'post'),
  },
  {
    title: 'Questing for recovery',
    description:
      'See how recovery quests, programming-friendly deloads, and smart scheduling keep consistency high without burning anybody out.',
    href: getPermalink('questing-for-recovery', 'post'),
  },
];

const heroPoster = heroPosterImage.src;
const canonicalUrl = metadata.canonical;
const profileScreenshotUrl = new URL(profileScreenshot.src, Astro.site).toString();
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Workout Quest',
  url: canonicalUrl,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS, Android',
  description: metadata.description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  downloadUrl:
    'https://apps.apple.com/us/app/workout-quest-fitness-tracker/id6452191825?ign-itscg=30200&ign-itsct=apps_box_badge',
  screenshot: profileScreenshotUrl,
  image: profileScreenshotUrl,
  sameAs: [
    'https://apps.apple.com/us/app/workout-quest-fitness-tracker/id6452191825?ign-itscg=30200&ign-itsct=apps_box_badge',
    'https://play.google.com/store/apps/details?id=fitness.tracker&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1',
  ],
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Workout Quest',
  url: canonicalUrl,
  logo: profileScreenshotUrl,
  sameAs: softwareSchema.sameAs,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Workout Quest',
  url: canonicalUrl,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.description,
    },
  })),
};
---

<Layout metadata={metadata}>
  <section class="relative bg-black h-screen">
    <div class="absolute inset-0">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-30 motion-reduce:block motion-safe:hidden"
        style={`background-image:url('${heroPoster}')`}
        aria-hidden="true"
      />
      <video
        id="hero-video"
        data-high-quality-src="/landing.mp4"
        muted
        loop
        playsinline
        preload="none"
        poster={heroPoster}
        class="absolute inset-0 w-full h-full object-cover opacity-40 motion-safe:block motion-reduce:hidden"
        aria-hidden="true"
      >
        Your browser does not support the video tag.
      </video>
    </div>

    <div class="relative z-10 flex items-center justify-center h-full">
      <div class="text-center text-white max-w-md mx-auto">
        <h1 class="text-5xl font-bold">Level Up Your Fitness Journey</h1>
        <p class="mt-4 text-lg">
          Track your workouts, level-up, and compete with friends for <strong>free</strong> in Workout Quest
        </p>

        <div class="mt-8 flex justify-center space-x-4">
          <a
            href="https://play.google.com/store/apps/details?id=fitness.tracker&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-primary rounded-lg text-white flex items-center space-x-2"
          >
            <span>Android Play Store</span>
            <icon name="tabler:download"></icon>
          </a>

          <a
            href="https://apps.apple.com/au/app/workout-quest-fitness-tracker/id6452191825?ign-itscg=30200&ign-itsct=apps_box_badge"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-primary rounded-lg text-white flex items-center space-x-2"
          >
            <span>iOS App Store</span>
            <icon name="tabler:download"></icon>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Features
    id="features"
    tagline="Features"
    title="Key Features of Workout Quest"
    items={[
      {
        title: 'Extensive Workout Library',
        description: 'Access a wide range of workouts, complete with clear GIF demonstrations for each exercise.',
        icon: 'tabler:bookmarks',
      },
      {
        title: 'AI-Powered Personalization',
        description: 'Get customized workout plans tailored to your fitness history, goals and available equipment.',
        icon: 'tabler:brain',
      },
      {
        title: 'Connect and Compete',
        description: 'Join your friends, share your progress, and take on challenges with friends.',
        icon: 'tabler:users',
      },
      {
        title: 'Quick and Easy Workout Tracking',
        description:
          'Track your progress efficiently with easy access to previous workouts and estimated 1 rep maxes on the fly.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Achievement System',
        description: 'Unlock rewards and celebrate milestones as you progress in your fitness journey.',
        icon: 'tabler:medal',
      },
      {
        title: 'Comprehensive Insights',
        description: 'Stay on-top of your training by utilizing our graphs and streak calendar to track your progress.',
        icon: 'tabler:database',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Your Journey, Your Rules"
    title="Revolutionize Your Workout Routine with Workout Quest"
    image={{
      src: '~/assets/images/ss-building.png',
      alt: 'Workout Quest Home Workouts Screen',
    }}
    items={[
      {
        title: 'Adaptable Home & Gym Workouts',
        description:
          'A dynamic workout platform that adapts to your environment, whether you’re at home or in the gym, Workout Quest helps find and select the exercises that are right for you.',
      },
      {
        title: 'Innovative AI-Driven Customization',
        description:
          'Our cutting-edge AI system creates personalized workout plans, considering your fitness level, goals, and available equipment, ensuring a tailored fitness experience.',
      },
      {
        title: 'Community and Competition',
        description:
          'Engage with your friends, share achievements, and foster a competitive yet supportive environment to reach your goals.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Empower Your Fitness Journey</h3>
      Gamify your workouts with our unique blend of technology and community support. From home-based exercises to gym
      routines, our app guides you every step of the way.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Stats
    stats={[
      { title: 'Workouts Completed', amount: '10,000+' },
      { title: 'Active Users', amount: '5000+' },
      { title: 'Achievements Earned', amount: '2,400+' },
      { title: 'Friends Added', amount: '500+' },
    ]}
  />

  <section class="bg-slate-50 dark:bg-slate-900">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">Deep dives</p>
        <h2 class="mt-3 text-3xl font-bold text-black dark:text-white">Anchor your journey in the logbook</h2>
        <p class="mt-2 text-lg text-muted dark:text-slate-300">
          Dive into the thinking that powers Workout Quest: why quests keep motivation high, where the product is headed, and how
          recovery rituals keep every quest sustainable.
        </p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {quickReads.map((link) => (
          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 text-left transition hover:border-primary dark:border-slate-700 dark:bg-slate-800"
            href={link.href}
          >
            <h3 class="text-xl font-semibold text-black dark:text-white group-hover:text-primary">{link.title}</h3>
            <p class="mt-2 text-sm text-muted dark:text-slate-300">{link.description}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Content
    id="insights"
    tagline="Notes from the lab"
    title="Theorycrafting the Gamified Training Loop"
    image={{
      src: '~/assets/images/ss-profile.png',
      alt: 'Workout Quest insight dashboard preview',
    }}
    items={blogHighlights}
    columns={2}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-300">
        We double-click on the articles powering Workout Quest to share why gamification works, the metrics we chase, and the upcoming
        features that will keep every quest fresh.
      </p>
    </Fragment>
  </Content>

  <FAQs id="faqs" tagline="FAQs" title="Frequently Asked Questions" items={faqItems} columns={2} />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Join On Android',
        href: 'https://play.google.com/store/apps/details?id=fitness.tracker&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1',
        target: '_blank',
        icon: 'tabler:download',
      },
      {
        variant: 'primary',
        text: 'Join On iOS',
        href: 'https://apps.apple.com/us/app/workout-quest-fitness-tracker/id6452191825?ign-itscg=30200&ign-itsct=apps_box_badge',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Join the <span class="sm:whitespace-nowrap">Fitness Revolution</span>
    </Fragment>

    <Fragment slot="subtitle">
      Don't just work out, embark on a quest! Transform your workouts into a thrilling journey with Workout Quest, the gamified
      workout tracker.
    </Fragment>
  </CallToAction>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script type="module">
    if (typeof window !== 'undefined') {
      const heroVideo = document.getElementById('hero-video');
      const highQualitySrc = heroVideo?.dataset?.highQualitySrc;

      if (heroVideo) {
        const loadVideoSources = () => {
          // Add video sources after page is interactive
          const webmSource = document.createElement('source');
          webmSource.src = '/landing.webm';
          webmSource.type = 'video/webm';
          heroVideo.appendChild(webmSource);

          const mp4Source = document.createElement('source');
          mp4Source.src = '/landing.mp4';
          mp4Source.type = 'video/mp4';
          heroVideo.appendChild(mp4Source);

          // Enable autoplay and play
          heroVideo.autoplay = true;
          heroVideo.play().catch(() => {
            console.log('Video autoplay unavailable');
          });

          // Later, swap to HD if available (low priority)
          if (highQualitySrc) {
            const swapToHighQuality = () => {
              if (mp4Source && mp4Source.src !== highQualitySrc) {
                const currentTime = heroVideo.currentTime;
                mp4Source.src = highQualitySrc;
                heroVideo.load();
                heroVideo.currentTime = currentTime;
              }
            };

            // Use requestIdleCallback if available, otherwise wait 3 seconds
            if ('requestIdleCallback' in window) {
              requestIdleCallback(() => swapToHighQuality());
            } else {
              setTimeout(swapToHighQuality, 3000);
            }
          }
        };

        // Load video after page becomes interactive
        if (document.readyState === 'loading') {
          window.addEventListener('load', loadVideoSources, { once: true });
        } else {
          loadVideoSources();
        }
      }
    }
  </script>
</Layout>
