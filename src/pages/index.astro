      {
        variant: 'primary',
        text: 'Join On iOS',
        href: 'https://apps.apple.com/us/app/workout-quest-fitness-tracker/id6452191825?ign-itscg=30200&ign-itsct=apps_box_badge',
        target: '_blank',
        icon: 'tabler:download',
