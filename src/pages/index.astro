  <script>
    // Hero video swap: reveal video when it can play through first frame to avoid layout jank
    (function(){
      const vid = document.getElementById('hero-video');
      const webmSource = document.getElementById('hero-source-webm');
      const mp4Source = document.getElementById('hero-source-mp4');
      if(!vid) return;

      // Lazy-load video sources off the critical path.
      function attachSources(){
        try{
          // If already attached, noop
          if(webmSource && webmSource.getAttribute('src')) return;

          // Prefer a smaller webm on small screens
          if(window.innerWidth && window.innerWidth <= 640 && webmSource){
            webmSource.setAttribute('src', webmSource.getAttribute('data-src').replace('/landing.webm','/landing-small.webm'));
          }else{
            if(webmSource) webmSource.setAttribute('src', webmSource.getAttribute('data-src'));
            if(mp4Source) mp4Source.setAttribute('src', mp4Source.getAttribute('data-src'));
          }

          // Tell the browser to reload the media now that sources are present
          vid.load();
        }catch(e){/* ignore attach errors */}
      }

      // Use requestIdleCallback to attach sources when browser is idle, with a timeout fallback.
      if('requestIdleCallback' in window){
        requestIdleCallback(attachSources, {timeout: 500});
      }else{
        setTimeout(attachSources, 300);
      }

      // Swap to mobile-optimized source on very small screens if we didn't already set it above
      try{
        if(window.innerWidth && window.innerWidth <= 640 && webmSource && !webmSource.getAttribute('src')){
          webmSource.setAttribute('src','/landing-small.webm');
          // reload sources so browser picks up the new src
          vid.load();
        }
      }catch(e){/* ignore */}

      // Try to autoplay: muted + playsinline increases chance
      function revealVideo(){
        // fade in video
        vid.style.opacity = '1';
        // enable pointer events if needed
        vid.style.pointerEvents = 'auto';
      }

      // If the video can play, reveal it. Use canplay or loadeddata fallback.
      const onCanPlay = () => {
        // Attempt to play (some browsers require a user gesture, but muted helps)
        vid.play().catch(()=>{/* autoplay blocked; leave poster visible but keep muted playback for user start */});
        revealVideo();
      };

      vid.addEventListener('canplay', onCanPlay, {once:true});
      vid.addEventListener('loadeddata', onCanPlay, {once:true});

      // Fallback timeout: if video hasn't fired within 2s, keep poster visible
      setTimeout(()=>{
        if(getComputedStyle(vid).opacity === '0'){
          // keep poster visible by leaving video hidden
          vid.style.opacity = '0';
        }
      }, 2000);

    })();
  </script>
