const metadata = {
  title: 'Workout Quest: Gamified Workout Tracker App',
  ignoreTitleTemplate: true,
  description: 'Track your exercises, earn achievements and level up as you train, at home or at the gym, with Workout Quest. Download the app for free on iOS and Android!',
