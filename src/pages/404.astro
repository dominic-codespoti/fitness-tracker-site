---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import heroThumbs from '~/assets/images/hero-thumbs.png';
import { getCanonical, getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
const metadata = {
  title,
  robots: { index: false },
  canonical: null,
  openGraph: {
    url: String(getCanonical('/404')),
    images: [{ url: '/og-image.png', width: 1200, height: 630 }],
  },
};
---

<Layout metadata={metadata}>
  <section class="px-5 py-16">
    <div class="mx-auto flex max-w-md flex-col items-center text-center">
      <Image src={heroThumbs} alt="" widths={[220, 440]} sizes="220px" class="w-[220px]" loading="eager" />
      <h1 class="comic-title mt-4 text-8xl">
        <span class="sr-only">Error</span>
        <span class="hl">404</span>
      </h1>
      <p class="mt-6 font-heading text-3xl font-black">This quest leads nowhere.</p>
      <p class="mt-3 text-lg text-muted">We couldn't find this page, but there's plenty more on the homepage.</p>
      <a href={getHomePermalink()} class="btn-primary mt-8">Back to homepage</a>
    </div>
  </section>
</Layout>
