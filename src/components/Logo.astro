---
import { Image } from 'astro:assets';
import appIcon from '~/assets/images/app-icon.png';
import { SITE } from '~/utils/config';
---

<span class="flex items-center gap-2.5 self-center whitespace-nowrap">
  <Image
    src={appIcon}
    alt=""
    width={40}
    height={40}
    densities={[1, 2]}
    loading="eager"
    class="h-10 w-10 rounded-[11px] border-2 border-ink shadow-comic-sm"
  />
  <span class="font-heading text-xl font-black uppercase tracking-tight text-default">{SITE?.name}</span>
</span>
