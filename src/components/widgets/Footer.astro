---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import StoreBadges from '~/components/StoreBadges.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  links?: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="relative border-t-2 border-ink bg-face not-prose">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-10 md:flex-row md:justify-between md:px-6">
    <div class="flex flex-col items-center gap-3 md:items-start">
      <a href={getHomePermalink()} aria-label="Workout Quest home"><Logo /></a>
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm font-bold">
          {
            links.map(({ text, href }) => (
              <li>
                <a class="hover:text-primary" href={href}>
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="flex flex-col items-center gap-3 md:items-end">
      <StoreBadges size="sm" />
      <div class="flex items-center gap-3 text-sm text-muted">
        <Fragment set:html={footNote} />
        {
          socialLinks.map(({ href, ariaLabel, icon }) => (
            <a
              class="text-muted hover:text-default"
              href={href}
              aria-label={ariaLabel}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="h-5 w-5" name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
