---
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
  currentTitle?: string;
}

const { posts, currentTitle } = Astro.props;
const relatedPosts = currentTitle ? posts.filter((post) => post.title !== currentTitle) : posts;
---

{
  relatedPosts.length > 0 && (
    <section
      class="mx-auto px-6 sm:px-6 max-w-3xl mt-12"
      aria-label={currentTitle ? `Related posts to ${currentTitle}` : 'Related posts'}
    >
      <h2 class="text-2xl font-black leading-tight mb-4 font-heading">Related posts</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {relatedPosts.map((post) => (
          <a
            class="comic-card group flex flex-col p-5 text-left shadow-comic-sm transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-comic"
            href={getPermalink(post.permalink, 'post')}
          >
            <h3 class="text-lg font-extrabold font-heading">{post.title}</h3>
            {post.excerpt && <p class="mt-2 flex-1 text-sm text-muted">{post.excerpt}</p>}
            <span class="mt-4 inline-flex text-sm font-bold text-primary">Read article →</span>
          </a>
        ))}
      </div>
    </section>
  )
}
