---
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
  currentTitle?: string;
}

const { posts, currentTitle } = Astro.props;
const relatedPosts = currentTitle ? posts.filter((post) => post.title !== currentTitle) : posts;
---

{
  relatedPosts.length > 0 && (
    <section
      class="mx-auto px-6 sm:px-6 max-w-3xl mt-12"
      aria-label={currentTitle ? `Related posts to ${currentTitle}` : 'Related posts'}
    >
      <h2 class="text-2xl font-bold leading-tight mb-4 font-heading dark:text-slate-300">Related posts</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {
          relatedPosts.map((post) => (
            <a
              class="group rounded-2xl border border-slate-200 bg-white p-5 text-left transition hover:border-primary dark:border-slate-700 dark:bg-slate-800"
              href={getPermalink(post.permalink, 'post')}
            >
              <h3 class="text-lg font-semibold text-black dark:text-white group-hover:text-primary font-heading">
                {post.title}
              </h3>
              {post.excerpt && <p class="mt-2 text-sm text-muted dark:text-slate-300">{post.excerpt}</p>}
              <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read article →</span>
            </a>
          ))
        }
      </div>
    </section>
  )
}
