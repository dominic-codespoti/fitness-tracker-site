---
import { Image } from 'astro:assets';
import StoreBadges from '~/components/StoreBadges.astro';
import appIcon from '~/assets/images/app-icon.png';
---

<div class="mx-auto mt-12 max-w-3xl px-6">
  <div class="comic-card flex flex-col items-center gap-5 p-6 text-center shadow-comic sm:flex-row sm:p-8 sm:text-left">
    <Image
      src={appIcon}
      alt=""
      width={88}
      height={88}
      densities={[1, 2]}
      class="h-[88px] w-[88px] shrink-0 rounded-[22px] border-2 border-ink shadow-comic-sm"
    />
    <div class="flex-1">
      <h2 class="font-heading text-2xl font-black leading-tight">Download Workout Quest</h2>
      <p class="mt-1 text-muted">Level up every workout. Free to start on iOS and Android.</p>
      <StoreBadges size="sm" class="mt-4 sm:justify-start" />
    </div>
  </div>
</div>
